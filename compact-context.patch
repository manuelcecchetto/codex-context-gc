new file mode 100644
index 000000000..63262d480
--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/compact_context.rs
@@ -0,0 +1,69 @@
+use crate::context::SemanticCheckpoint;
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::FunctionToolOutput;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolPayload;
+use crate::tools::context::boxed_tool_output;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use codex_tools::JsonSchema;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use std::collections::BTreeMap;
+
+pub struct CompactContextHandler;
+
+/// Turn-local intent: aborting or replacing the turn cannot compact a later turn.
+#[derive(Debug, Default)]
+pub(crate) struct SemanticCompactionState {
+    pub pending: Option<SemanticCheckpoint>,
+}
+
+impl ToolExecutor<ToolInvocation> for CompactContextHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("compact_context")
+    }
+    fn spec(&self) -> ToolSpec {
+        let mut properties = BTreeMap::new();
+        for name in ["completed_phase", "next_focus"] {
+            properties.insert(name.to_string(), JsonSchema::string(None));
+        }
+        for name in ["keep", "open_loops", "ruled_out", "verification"] {
+            properties.insert(
+                name.to_string(),
+                JsonSchema::array(JsonSchema::string(None), None),
+            );
+        }
+        ToolSpec::Function(ResponsesApiTool {
+            name: "compact_context".to_string(),
+            description: "Checkpoint a completed phase and compact obsolete context before a materially different next phase. Native compaction runs after the entire tool batch and resumes this turn. Call alone, then stop issuing work until continuation. Do not call for token pressure alone, unresolved hypotheses, or before the final answer. Supply concrete verification and concise durable facts. All checkpoint content is carried forward verbatim; size does not cause rejection or truncation. There is no per-turn request limit. New pending input cancels the request.".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: JsonSchema::object(properties, Some(vec!["completed_phase".into(), "next_focus".into(), "keep".into(), "verification".into()]), Some(false.into())),
+            output_schema: None,
+        })
+    }
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = invocation.payload else {
+                return Err(FunctionCallError::RespondToModel(
+                    "compact_context requires function arguments".into(),
+                ));
+            };
+            let checkpoint =
+                SemanticCheckpoint::parse(&arguments).map_err(FunctionCallError::RespondToModel)?;
+            let mut state = invocation.turn.semantic_compaction.lock().await;
+            if state.pending.is_some() {
+                return Err(FunctionCallError::RespondToModel("A checkpoint is already pending. Wait for compaction and continuation before requesting another.".into()));
+            }
+            state.pending = Some(checkpoint);
+            Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                "Checkpoint accepted. After this complete tool batch, the harness will compact and resume unless new input is pending.".into(), Some(true))))
+        })
+    }
+}
+impl CoreToolRuntime for CompactContextHandler {}
