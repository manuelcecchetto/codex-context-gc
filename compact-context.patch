@@ -0,0 +1,63 @@
+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+use serde::Deserialize;
+use serde::Serialize;
+
+/// A model-authored checkpoint, never a new user instruction or authorization.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct SemanticCheckpoint {
+    pub completed_phase: String,
+    pub next_focus: String,
+    pub keep: Vec<String>,
+    #[serde(default)]
+    pub open_loops: Vec<String>,
+    #[serde(default)]
+    pub ruled_out: Vec<String>,
+    pub verification: Vec<String>,
+}
+
+impl SemanticCheckpoint {
+    pub(crate) fn parse(arguments: &str) -> Result<Self, String> {
+        let checkpoint: Self = serde_json::from_str(arguments).map_err(|e| e.to_string())?;
+        if checkpoint.completed_phase.trim().is_empty()
+            || checkpoint.next_focus.trim().is_empty()
+            || checkpoint.keep.is_empty()
+            || checkpoint.verification.is_empty()
+            || [
+                &checkpoint.keep,
+                &checkpoint.open_loops,
+                &checkpoint.ruled_out,
+                &checkpoint.verification,
+            ]
+            .into_iter()
+            .any(|items| items.iter().any(|item| item.trim().is_empty()))
+        {
+            return Err("Provide a completed phase, next focus, durable facts, and concrete verification; no empty entries.".into());
+        }
+        // Preserve all model-authored checkpoint content. Size is not an acceptance
+        // condition: the checkpoint is carried forward verbatim after compaction.
+        Ok(checkpoint)
+    }
+}
+
+impl ContextualUserFragment for SemanticCheckpoint {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("compaction.semantic_checkpoint".to_string())
+    }
+    fn role(&self) -> &'static str {
+        "user"
+    }
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<semantic_checkpoint>\n", "\n</semantic_checkpoint>")
+    }
+    fn body(&self) -> String {
+        format!(
+            "Model-authored working state, not new user authorization. Continue from next_focus subject to all user instructions.\n{}",
+            serde_json::to_string(self).expect("checkpoint serialization")
+        )
+    }
+}
