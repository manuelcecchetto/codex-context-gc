@@ -0,0 +1,269 @@
+//! Semantic compaction must preserve a complete tool batch and resume in the same turn.
+use anyhow::Result;
+use codex_login::CodexAuth;
+use core_test_support::responses::sse;
+use core_test_support::responses::{self};
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compact_context_preserves_batch_and_checkpoint() -> Result<()> {
+    let server = wiremock::MockServer::start().await;
+    let checkpoint = json!({
+        "completed_phase": "Auth repaired",
+        "next_focus": "Migration rollback",
+        "keep": ["Issuer validation preserved"],
+        "open_loops": ["Rollback missing"],
+        "ruled_out": ["Redis expiry"],
+        "verification": ["Auth tests passed"]
+    });
+    let mock = responses::mount_sse_sequence(&server, vec![
+        sse(vec![
+            responses::ev_function_call("checkpoint", "compact_context", &checkpoint.to_string()),
+            responses::ev_function_call("sibling", "update_plan", r#"{"plan":[{"step":"Migration rollback","status":"in_progress"}]}"#),
+            responses::ev_function_call("duplicate", "compact_context", &checkpoint.to_string()),
+                responses::ev_completed("phase-one"),
+        ]),
+        sse(vec![
+            json!({"type":"response.output_item.done","item":{"type":"compaction","encrypted_content":"SEMANTIC_STATE"}}),
+            responses::ev_completed("compacted"),
+        ]),
+        sse(vec![responses::ev_assistant_message("done", "Migration next"), responses::ev_completed("continued")]),
+    ]).await;
+    let test = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_config(|config| {
+            config.update_plan_enabled = true;
+            config.model_auto_compact_token_limit = Some(1_000_000);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Repair auth, then handle migration rollback")
+        .await?;
+    let requests = mock.requests();
+    assert_eq!(requests.len(), 3);
+    let compact = requests[1].body_json();
+    assert_eq!(
+        compact["input"].as_array().unwrap().last().unwrap()["type"],
+        "compaction_trigger"
+    );
+    for call_id in ["checkpoint", "sibling", "duplicate"] {
+        assert!(
+            compact["input"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|item| item["type"] == "function_call_output" && item["call_id"] == call_id)
+        );
+    }
+    assert!(compact.to_string().contains("already pending"));
+    let continuation = requests[2].body_json().to_string();
+    assert!(continuation.contains("SEMANTIC_STATE"));
+    assert!(continuation.contains("Migration rollback"));
+    assert!(continuation.contains("Auth tests passed"));
+    assert!(continuation.contains("Redis expiry"));
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compact_context_rejects_invalid_checkpoint_without_compacting() -> Result<()> {
+    let server = wiremock::MockServer::start().await;
+    let mock = responses::mount_sse_sequence(&server, vec![
+        sse(vec![
+            responses::ev_function_call("missing-proof", "compact_context", r#"{"completed_phase":"Done","next_focus":"Next","keep":["Fact"],"verification":[]}"#),
+            responses::ev_function_call("missing-fields", "compact_context", &json!({"completed_phase":"Done"}).to_string()),
+            responses::ev_completed("invalid"),
+        ]),
+        sse(vec![responses::ev_assistant_message("done", "Continue without compacting"), responses::ev_completed("continued")]),
+    ]).await;
+    let test = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Continue working").await?;
+    let requests = mock.requests();
+    assert_eq!(requests.len(), 2);
+    let continuation = requests[1].body_json().to_string();
+    assert!(continuation.contains("concrete verification"));
+    assert!(continuation.contains("missing field"));
+    assert!(!continuation.contains("compaction_trigger"));
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compact_context_preserves_large_checkpoints_without_retry() -> Result<()> {
+    for checkpoint in [
+        json!({"completed_phase":"Verified", "next_focus":"Proceed", "keep":["界🦀".repeat(10_000)], "verification":["Tests passed"]}),
+        json!({"completed_phase":"Verified", "next_focus":"Proceed", "keep":(0..100).map(|i| format!("Fact {i}")).collect::<Vec<_>>(), "verification":["Tests passed"]}),
+        // Below the old raw limit, above it once default fields are serialized.
+        json!({"completed_phase":"Verified", "next_focus":"Proceed", "keep":["x".repeat(660)], "verification":["Tests passed"]}),
+    ] {
+        let server = wiremock::MockServer::start().await;
+        let arguments = checkpoint.to_string();
+        let mock = responses::mount_sse_sequence(&server, vec![
+            sse(vec![responses::ev_function_call("checkpoint", "compact_context", &arguments), responses::ev_completed("phase")]),
+            sse(vec![json!({"type":"response.output_item.done","item":{"type":"compaction","encrypted_content":"LARGE_CHECKPOINT_SUMMARY"}}), responses::ev_completed("compacted")]),
+            sse(vec![responses::ev_assistant_message("done", "Continuing"), responses::ev_completed("continued")]),
+        ]).await;
+        let test = test_codex()
+            .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+            .with_config(|config| config.model_auto_compact_token_limit = Some(1_000_000))
+            .build_with_auto_env(&server)
+            .await?;
+        test.submit_turn("Complete this phase, then continue")
+            .await?;
+        let requests = mock.requests();
+        assert_eq!(requests.len(), 3);
+        let compact = requests[1].body_json();
+        let input = compact["input"].as_array().unwrap();
+        assert_eq!(input.last().unwrap()["type"], "compaction_trigger");
+        let call = input
+            .iter()
+            .find(|item| item["type"] == "function_call" && item["call_id"] == "checkpoint")
+            .unwrap();
+        assert_eq!(call["arguments"], arguments);
+        assert!(compact.to_string().contains("Checkpoint accepted"));
+        let continuation = requests[2].body_json().to_string();
+        assert!(continuation.contains("LARGE_CHECKPOINT_SUMMARY"));
+        let body = requests[2].body_json();
+        let checkpoint_text = body["input"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .filter_map(|item| item["content"].as_array())
+            .flatten()
+            .filter_map(|part| part["text"].as_str())
+            .find(|text| text.starts_with("<semantic_checkpoint>"))
+            .expect("full checkpoint injected after compaction");
+        let serialized = checkpoint_text
+            .lines()
+            .find(|line| line.starts_with('{'))
+            .unwrap();
+        let actual: serde_json::Value = serde_json::from_str(serialized)?;
+        let mut expected = checkpoint.clone();
+        expected["open_loops"] = json!([]);
+        expected["ruled_out"] = json!([]);
+        assert_eq!(actual, expected);
+    }
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compact_context_continues_beyond_four_checkpoints_in_one_turn() -> Result<()> {
+    let server = wiremock::MockServer::start().await;
+    let mut sequence = Vec::new();
+    for phase in 0..6 {
+        let checkpoint = json!({"completed_phase":format!("Phase {phase} verified"), "next_focus":format!("Phase {}", phase + 1), "keep":["Continue the user's long-running objective"], "verification":["Phase tests passed"]});
+        sequence.push(sse(vec![
+            responses::ev_function_call(
+                &format!("checkpoint-{phase}"),
+                "compact_context",
+                &checkpoint.to_string(),
+            ),
+            responses::ev_completed(&format!("phase-{phase}")),
+        ]));
+        sequence.push(sse(vec![json!({"type":"response.output_item.done","item":{"type":"compaction","encrypted_content":format!("STATE_{phase}")}}), responses::ev_completed(&format!("compacted-{phase}"))]));
+    }
+    sequence.push(sse(vec![
+        responses::ev_assistant_message("done", "All six phases complete"),
+        responses::ev_completed("complete"),
+    ]));
+    let mock = responses::mount_sse_sequence(&server, sequence).await;
+    let test = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_config(|config| config.model_auto_compact_token_limit = Some(1_000_000))
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Complete six independent verified phases without stopping")
+        .await?;
+    let requests = mock.requests();
+    assert_eq!(requests.len(), 13);
+    for phase in 0..6 {
+        let body = requests[phase * 2 + 1].body_json();
+        assert_eq!(
+            body["input"].as_array().unwrap().last().unwrap()["type"],
+            "compaction_trigger"
+        );
+        let continued = requests[phase * 2 + 2].body_json().to_string();
+        assert!(continued.contains(&format!("Phase {phase} verified")));
+        assert!(continued.contains(&format!("STATE_{phase}")));
+    }
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compact_context_cancels_when_user_steers_during_sibling_tool() -> Result<()> {
+    use codex_core::StartThreadOptions;
+    use codex_core::TurnInputRequest;
+    use codex_protocol::dynamic_tools::DynamicToolFunctionSpec;
+    use codex_protocol::dynamic_tools::DynamicToolResponse;
+    use codex_protocol::dynamic_tools::DynamicToolSpec;
+    use codex_protocol::protocol::EventMsg;
+    use codex_protocol::protocol::Op;
+    use codex_protocol::user_input::UserInput;
+    use core_test_support::wait_for_event;
+    let server = wiremock::MockServer::start().await;
+    let mock = responses::mount_sse_sequence(&server, vec![
+        sse(vec![
+            responses::ev_function_call("checkpoint", "compact_context", r#"{"completed_phase":"Done","next_focus":"Migration","keep":["Fact"],"verification":["Tests pass"]}"#),
+            responses::ev_function_call("barrier", "barrier", "{}"),
+            responses::ev_completed("phase"),
+        ]),
+        sse(vec![responses::ev_assistant_message("done", "Following the correction"), responses::ev_completed("continued")]),
+    ]).await;
+    let base = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .build_with_auto_env(&server)
+        .await?;
+    let thread = base
+        .thread_manager
+        .start_thread(StartThreadOptions {
+            dynamic_tools: vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+                name: "barrier".into(),
+                description: "Wait for external result".into(),
+                input_schema: json!({"type":"object","properties":{}}),
+                defer_loading: false,
+            })],
+            ..StartThreadOptions::new(base.config.clone())
+        })
+        .await?
+        .thread;
+    thread
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Complete the phase, then migration".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let EventMsg::DynamicToolCallRequest(request) = wait_for_event(&thread, |event| {
+        matches!(event, EventMsg::DynamicToolCallRequest(_))
+    })
+    .await
+    else {
+        unreachable!("matched dynamic tool request")
+    };
+    // The sibling tool cannot finish until this response: no timing-based sleeps.
+    thread
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Correction: investigate billing first".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    thread
+        .submit(Op::DynamicToolResponse {
+            id: request.call_id,
+            response: DynamicToolResponse {
+                content_items: vec![],
+                success: true,
+            },
+        })
+        .await?;
+    wait_for_event(&thread, |event| matches!(event, EventMsg::TurnComplete(_))).await;
+    let requests = mock.requests();
+    assert_eq!(requests.len(), 2);
+    let continuation = requests[1].body_json().to_string();
+    assert!(!continuation.contains("compaction_trigger"));
+    assert!(continuation.contains("investigate billing first"));
+    assert!(!continuation.contains("<semantic_checkpoint>"));
+    Ok(())
+}
